{
  "name": "@mercuryworkshop/wisp-js",
  "version": "0.5.0",
  "description": "A client and server for the Wisp protocol, written in Javascript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MercuryWorkshop/wisp-js.git"
  },
  "author": "MercuryWorkshop",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/MercuryWorkshop/wisp-js/issues"
  },
  "homepage": "https://github.com/MercuryWorkshop/wisp-js#readme",
  "main": "./dist/wisp-full.mjs",
  "exports": {
    ".": {
      "import": "./dist/wisp-full.mjs",
      "require": "./dist/wisp-full.cjs"
    },
    "./client": {
      "import": "./dist/wisp-client.mjs",
      "require": "./dist/wisp-client.cjs"
    },
    "./server": {
      "import": "./dist/wisp-client.mjs",
      "require": "./dist/wisp-server.cjs"
    }
  },
  "browser": {
    ".": "./dist/wisp-full.mjs",
    "./client": "./dist/wisp-client.mjs",
    "./server": "./dist/wisp-server.mjs",
    "./src/compat.ts": "./src/compat_browser.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "webpack",
    "build:prod": "webpack --mode=production",
    "dev": "webpack --watch",
    "server_cli": "node ./src/bin/server_cli.mjs"
  },
  "bin": {
    "wisp-js-server": "src/bin/server_cli.mjs"
  },
  "dependencies": {
    "bufferutil": "^4.1.0",
    "commander": "^15.0.0",
    "ipaddr.js": "^2.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "babel-loader": "^10.1.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  }
}
